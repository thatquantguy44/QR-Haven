#!/usr/bin/env bash
set -u

# Block commits whose author/committer identity looks like an AI agent.
# The expected identity is whatever the user has configured in git
# (user.name / user.email); nothing is hardcoded here.

check_value() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    return 1
  fi

  case "$value" in
    Claude|Claude*|Codex|Codex*|OpenAI|OpenAI*|*claude*|*codex*|*openai*|*anthropic*|*noreply@anthropic.com* )
      return 0
      ;;
    * )
      return 1
      ;;
  esac
}

expected_name="$(git config --get user.name || true)"
expected_email="$(git config --get user.email || true)"

for var in GIT_AUTHOR_NAME GIT_COMMITTER_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL; do
  if check_value "${!var:-}"; then
    echo "Blocked: commit identity resolved to an AI agent (${var}=${!var})."
    echo "Expected identity: ${expected_name:-<unset>} <${expected_email:-<unset>}>"
    exit 1
  fi
done

# Also stop if the effective git config itself is an agent identity.
if check_value "$expected_name" || check_value "$expected_email"; then
  echo "Blocked: git user.name/user.email is set to an AI agent."
  echo "Fix with: git config user.name \"Your Name\" && git config user.email \"you@example.com\""
  exit 1
fi

exit 0
